# Application
APP_NAME=test-demo-service
PORT=8080
APP_ENV=development
APP_READ_TIMEOUT=10s
APP_WRITE_TIMEOUT=10s

# JWT Security
JWT_SECRET=dev-secret-key-change-in-production-min-32-chars
JWT_EXPIRY=24h

# Primary Database (Local Docker / Postgres)
DB_PRIMARY_HOST=localhost
DB_PRIMARY_PORT=5432
DB_PRIMARY_USER=postgres
DB_PRIMARY_PASSWORD=password
DB_PRIMARY_NAME=shop_db
DB_PRIMARY_SSLMODE=disable
DB_PRIMARY_MAX_CONNS=20
DB_PRIMARY_MIN_CONNS=5
DB_PRIMARY_MAX_CONN_LIFETIME=1h
DB_PRIMARY_MAX_CONN_IDLE_TIME=30m
DATABASE_URL=postgres://postgres:password@localhost:5432/shop_db?sslmode=disable
