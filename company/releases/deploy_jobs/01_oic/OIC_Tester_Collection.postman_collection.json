			"name": "01 - Premium Calculation & OIC Tariff",
			"item": [
				{
					"name": "TC-OIC-07 Load Act Premium (645.21 THB)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"fn\": \"loadActPremium\",\n    \"data\": {\n        \"Comp_Code\": \"1.10\"\n    }\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/premium/actAPI",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "premium", "actAPI"]
						}
					}
				}
			]
		},
		{
