{
	"info": {
		"_postman_id": "11111111-2222-3333-4444-555566667777",
		"name": "test-demo-service - API Collection",
		"description": "Comprehensive Enterprise Postman Test Collection with Auto-Auth and RBAC",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Health Check",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/health",
					"host": ["{{base_url}}"],
					"path": ["health"]
				}
			}
		},
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"newuser@example.com\",\n  \"password\": \"Password123!\",\n  \"name\": \"New User\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/register",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "register"]
						}
					}
				},
				{
					"name": "Login (Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.token) {",
									"    pm.environment.set(\"jwt_token\", jsonData.data.token);",
									"    pm.environment.set(\"user_id\", jsonData.data.user.id);",
									"    console.log(\"Saved JWT Token:\", jsonData.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@maxme.co.th\",\n  \"password\": \"AdminSecure2026!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "login"]
						}
					}
				},
				{
					"name": "Get Profile (Me)",
					"request": {
						"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{jwt_token}}", "type": "string"}]},
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/api/v1/auth/me",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "me"]
						}
					}
				}
			]
		},
		{
			"name": "Users Management",
			"item": [
				{
					"name": "List Users (Admin / Manager)",
					"request": {
						"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{jwt_token}}", "type": "string"}]},
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/api/v1/users?limit=10&offset=0",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "users"],
							"query": [{"key": "limit", "value": "10"}, {"key": "offset", "value": "0"}]
						}
					}
				}
			]
		}
	]
}
