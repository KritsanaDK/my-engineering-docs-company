# Application
APP_NAME=test-demo-service
PORT=8080
APP_ENV=development
APP_READ_TIMEOUT=10s
APP_WRITE_TIMEOUT=10s

# JWT Security
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRY=24h

# Primary Database
DB_PRIMARY_HOST=localhost
DB_PRIMARY_PORT=5432
DB_PRIMARY_USER=postgres
DB_PRIMARY_PASSWORD=password
DB_PRIMARY_NAME=app_db
DB_PRIMARY_SSLMODE=disable
DATABASE_URL=postgres://postgres:password@localhost:5432/app_db?sslmode=disable
